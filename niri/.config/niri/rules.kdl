/*
 * Niri window rules
 *
 * Phase 31:
 * - Persistent media workspace
 * - Brave and Zed keep Niri's default placement
 */

/*
 * Spotify -> media workspace on HDMI-A-2
 */
window-rule {
    match app-id="^spotify$"
    open-on-output "HDMI-A-2"
    open-on-workspace "media"
}

/*
 * Vesktop -> media workspace on HDMI-A-2
 */
window-rule {
    match app-id="^vesktop$"
    open-on-output "HDMI-A-2"
    open-on-workspace "media"
}

/*
 * Kitty -> background blur
 */
window-rule {
    match app-id="kitty"
    background-effect {
        blur true
    }
}

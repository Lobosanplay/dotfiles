/*
 * Niri window rules
 *
 * Phase 31:
 * - Persistent media workspace
 * - Brave and Zed keep Niri's default placement
 */

/*
 * Spotify -> media workspace on HDMI-A-2
 */
window-rule {
    match app-id="^spotify$"
    open-on-output "HDMI-A-2"
    open-on-workspace "media"
}

/*
 * Vesktop -> media workspace on HDMI-A-2
 */
window-rule {
    match app-id="^vesktop$"
    open-on-output "HDMI-A-2"
    open-on-workspace "media"
}

/*
 * Obsidian and Nautilus open as centered-size floating windows.
 * OpenCode is a terminal TUI; when launched in Kitty it inherits Kitty's rule.
 */
window-rule {
    match app-id=r#"^(obsidian|com\.obsidian\.Obsidian|md\.obsidian\.Obsidian)$"#
    default-column-width { fixed 1100; }
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
    opacity 0.85
}

window-rule {
    match app-id="^org\\.gnome\\.Nautilus$"
    opacity 0.95
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match app-id="kitty"
    clip-to-geometry true
    draw-border-with-background false
}

// Keep DMS/Quickshell windows opaque (formerly supplied by DMS's generated include).
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.0
}

// Place the DMS wallpaper inside Niri's overview backdrop.
layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

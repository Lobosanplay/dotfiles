{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dotfiles semantic theme tokens",
  "description": "Version 2 theme preset contract. Colors are opaque sRGB hex values; component templates own opacity and rendering details.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "mode", "tokens", "typography", "iconography"],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "mode": { "const": "dark" },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaces", "text", "accents", "semantic", "borders"],
      "properties": {
        "surfaces": {
          "$ref": "#/$defs/colorGroup",
          "required": ["background", "surface", "surface_variant", "surface_elevated"],
          "properties": {
            "background": { "description": "Lowest-level desktop/background color." },
            "surface": { "description": "Default panel and application surface." },
            "surface_variant": { "description": "Contrasting surface within a panel or control." },
            "surface_elevated": { "description": "Raised surface such as a popover or card." }
          }
        },
        "text": {
          "$ref": "#/$defs/colorGroup",
          "required": ["primary", "secondary", "muted", "disabled"],
          "properties": {
            "primary": { "description": "Highest-emphasis readable text." },
            "secondary": { "description": "Supporting text." },
            "muted": { "description": "Low-emphasis labels and metadata." },
            "disabled": { "description": "Text for unavailable controls." }
          }
        },
        "accents": {
          "$ref": "#/$defs/colorGroup",
          "required": ["primary", "secondary", "selection", "focus"],
          "properties": {
            "primary": { "description": "Primary interactive and brand accent." },
            "secondary": { "description": "Secondary accent used for restrained variation." },
            "selection": { "description": "Selected item background or indicator." },
            "focus": { "description": "Keyboard focus indicator." }
          }
        },
        "semantic": {
          "$ref": "#/$defs/colorGroup",
          "required": ["success", "warning", "error", "info"],
          "properties": {
            "success": { "description": "Successful or healthy state." },
            "warning": { "description": "Cautionary state." },
            "error": { "description": "Failure or destructive state." },
            "info": { "description": "Informational state." }
          }
        },
        "borders": {
          "$ref": "#/$defs/colorGroup",
          "required": ["default", "subtle"],
          "properties": {
            "default": { "description": "Standard component boundary." },
            "subtle": { "description": "Low-emphasis separation line." }
          }
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["families", "scale_unit", "scale", "weights", "line_height"],
      "properties": {
        "families": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ui", "mono"],
          "properties": {
            "ui": { "$ref": "#/$defs/fontFamily" },
            "mono": { "$ref": "#/$defs/fontFamily" }
          }
        },
        "scale_unit": { "const": "logical-px" },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display", "title", "heading", "body", "label", "caption", "micro"],
          "properties": {
            "display": { "type": "integer", "minimum": 8, "maximum": 64 },
            "title": { "type": "integer", "minimum": 8, "maximum": 64 },
            "heading": { "type": "integer", "minimum": 8, "maximum": 64 },
            "body": { "type": "integer", "minimum": 8, "maximum": 64 },
            "label": { "type": "integer", "minimum": 8, "maximum": 64 },
            "caption": { "type": "integer", "minimum": 8, "maximum": 64 },
            "micro": { "type": "integer", "minimum": 8, "maximum": 64 }
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["regular", "medium", "semibold", "bold"],
          "properties": {
            "regular": { "const": 400 },
            "medium": { "const": 500 },
            "semibold": { "const": 600 },
            "bold": { "const": 700 }
          }
        },
        "line_height": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compact", "normal", "relaxed"],
          "properties": {
            "compact": { "type": "number", "exclusiveMinimum": 1, "maximum": 2 },
            "normal": { "type": "number", "exclusiveMinimum": 1, "maximum": 2 },
            "relaxed": { "type": "number", "exclusiveMinimum": 1, "maximum": 2 }
          }
        }
      }
    },
    "iconography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "family", "source", "symbol_format", "api", "aliases", "fallback"],
      "properties": {
        "provider": { "const": "material-symbols-rounded" },
        "family": { "const": "Material Symbols Rounded" },
        "source": { "const": "DMS-bundled" },
        "symbol_format": { "const": "lowercase-ligature-name" },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["DankIcon.name", "AppIconRenderer.iconValue"],
          "properties": {
            "DankIcon.name": { "const": "<ligature-name>" },
            "AppIconRenderer.iconValue": { "const": "material:<ligature-name>" }
          }
        },
        "aliases": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "fallback": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "fontFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "source", "fallback"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "fallback": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "colorGroup": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    }
  }
}
